---
// Year-grouped timeline (used on the About page).
export interface TimelineEntry {
  month?: string;
  title: string;
  description?: string;
  items?: string[];
}

export interface TimelineYear {
  year: string;
  entries: TimelineEntry[];
}

interface TimelineProps {
  years: TimelineYear[];
}

const { years }: TimelineProps = Astro.props;
---
<div class="timeline">
  {years.map(({ year, entries }) => (
    <section class="timeline__year">
      <div class="timeline__year-label">{year}</div>
      <div class="timeline__rail" aria-hidden="true"><span class="timeline__dot"></span></div>
      <div class="timeline__entries">
        {entries.map((entry) => (
          <div class="timeline__entry">
            <div class="timeline__month">{entry.month ?? '-'}</div>
            <div class="timeline__body">
              <div class="timeline__title">{entry.title}</div>
              {entry.description && <div class="timeline__description">{entry.description}</div>}
              {entry.items && entry.items.length > 0 && (
                <div class="timeline__items">
                  {entry.items.map((item) => (
                    <div class="timeline__item">{item}</div>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .timeline {
    --timeline-accent: #4cb963;

    margin: 1.5rem 0 2.5rem;
  }

  .timeline__year {
    display: grid;
    grid-template-columns: 7rem 1.5rem minmax(0, 1fr);
    column-gap: 1.25rem;
  }

  .timeline__year-label {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: var(--main-color);
  }

  .timeline__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Vertical line connecting this year's dot to the next year */
  .timeline__rail::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: .5rem;
    width: 1px;
    background-color: var(--border-color);
  }

  .timeline__year:last-child .timeline__rail::before {
    display: none;
  }

  .timeline__dot {
    width: .75rem;
    height: .75rem;
    margin-top: .75rem;
    border: 3px solid color-mix(in srgb, var(--timeline-accent) 35%, transparent);
    border-radius: 50%;
    background-color: var(--timeline-accent);
    background-clip: padding-box;
    box-sizing: content-box;
  }

  .timeline__entries {
    padding: .5rem 0 2.5rem;
  }

  .timeline__entry {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .timeline__entry + .timeline__entry {
    margin-top: 1.25rem;
  }

  .timeline__month {
    font-weight: 600;
    line-height: 1.6;
    color: var(--placeholder);
  }

  .timeline__title {
    font-weight: 600;
    line-height: 1.6;
    color: var(--main-color);
  }

  .timeline__description {
    font-size: .875rem;
    color: var(--text-color);
  }

  .timeline__items {
    display: flex;
    flex-direction: column;
    gap: .375rem;
    margin-top: .625rem;
  }

  .timeline__item {
    position: relative;
    padding-left: .875rem;
    font-size: .9375rem;
    line-height: 1.6;
    color: var(--secondary-color);
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    top: .7em;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--placeholder);
  }

  @media (max-width: 768px) {
    .timeline__year {
      grid-template-columns: 1rem minmax(0, 1fr);
      column-gap: .75rem;
    }

    .timeline__year-label {
      grid-column: 2;
      font-size: 1.75rem;
      margin-bottom: .5rem;
    }

    .timeline__rail {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .timeline__dot {
      margin-top: .5rem;
    }

    .timeline__entries {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>
