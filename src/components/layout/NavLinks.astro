---
type NavItem = {
  id: string;
  href: string;
  label: string;
};

interface NavLinksProps {
  navItems: NavItem[];
  variant?: 'desktop' | 'mobile';
}

const { navItems, variant = 'desktop' }: NavLinksProps = Astro.props;
const isMobile = variant === 'mobile';
const currentPath = Astro.url.pathname;
---
{isMobile ? (
  navItems.map(({ id, href, label }) => (
    <a href={href} class="mobile-menu__link" data-nav-item={id}>
      {label}
    </a>
  ))
) : (
  navItems.map(({ id, href, label }) => (
    <a
      href={href}
      class="header__category"
      data-nav-item={id}
      data-active={currentPath.startsWith(href) ? 'true' : 'false'}
    >
      {label}
    </a>
  ))
)}
