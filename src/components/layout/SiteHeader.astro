---
import Icon from '@components/Icon.astro';
import LanguageSwitcher from '@components/LanguageSwitcher.astro';
import CategoriesList from '@components/CategoriesList.astro';

type NavItem = {
  id: string;
  href: string;
  label: string;
};

type LanguageOption = {
  code: string;
  label: string;
  displayLabel: string;
  href: string;
  isActive: boolean;
  isAvailable: boolean;
};

interface SiteHeaderProps {
  lang: string;
  siteTitle: string;
  homeHref: string;
  navItems: NavItem[];
  languageOptions: LanguageOption[];
  showSearch: boolean;
  enableDarkMode: boolean;
}

const {
  lang,
  siteTitle,
  homeHref,
  navItems,
  languageOptions,
  showSearch,
  enableDarkMode,
}: SiteHeaderProps = Astro.props;
---
<header class="header">
  <div class="cont flex">
    <div class="header__left">
      <a href={homeHref} class="header__logo">
        <span class="header__logo-mark" aria-hidden="true"></span>{siteTitle}
      </a>
      <nav class="header__menu" aria-label="Main">
        <CategoriesList variant="header" />
      </nav>
    </div>
    <div class="header__nav">
      {showSearch && (
        <button type="button" class="header__search-toggle" aria-label="Toggle search">
          <Icon name="search" class="header__search-icon" />
          <span class="header__search-label">검색</span>
          <kbd class="header__search-kbd">⌘K</kbd>
        </button>
      )}
      {enableDarkMode && (
        <button type="button" class="header__theme-mode-switcher theme-mode-switcher" data-mode="light" aria-label="Toggle theme">
          <Icon name="dark_mode" class="theme-mode-switcher__icon icon-dark" />
          <Icon name="light_mode" class="theme-mode-switcher__icon icon-light" />
        </button>
      )}
      {languageOptions.length > 1 && <LanguageSwitcher lang={lang} options={languageOptions} />}
      <button type="button" class="header__menu-toggle" aria-label="Toggle menu">
        <Icon name="menu" class="header__menu-icon" />
      </button>
    </div>
  </div>
</header>
