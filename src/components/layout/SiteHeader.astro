---
import Icon from '@components/Icon.astro';
import LanguageSwitcher from '@components/LanguageSwitcher.astro';
import CategoriesList from '@components/CategoriesList.astro';

type NavItem = {
  id: string;
  href: string;
  label: string;
};

type LanguageOption = {
  code: string;
  label: string;
  displayLabel: string;
  href: string;
  isActive: boolean;
  isAvailable: boolean;
};

interface SiteHeaderProps {
  lang: string;
  siteTitle: string;
  homeHref: string;
  navItems: NavItem[];
  languageOptions: LanguageOption[];
  showSearch: boolean;
  enableDarkMode: boolean;
  backLink?: { href: string; label: string };
}

const {
  lang,
  siteTitle,
  homeHref,
  navItems,
  languageOptions,
  showSearch,
  enableDarkMode,
  backLink,
}: SiteHeaderProps = Astro.props;
---
<header class:list={['header', { 'header--has-back': backLink }]}>
  <div class="cont flex">
    {backLink && (
      <a href={backLink.href} class="header__back">
        <Icon name="arrow_back" /> {backLink.label}
      </a>
    )}
    <div class="header__left">
      <a href={homeHref} class="header__logo">
        <span class="header__logo-mark" aria-hidden="true"></span>{siteTitle}
      </a>
      <nav class="header__menu" aria-label="Main">
        <CategoriesList variant="header" />
      </nav>
    </div>
    <div class="header__nav">
      {showSearch && (
        <form class="header__search" role="search" action={homeHref} method="get">
          <button type="button" class="header__search-btn" aria-label="검색 열기">
            <Icon name="search" class="header__search-icon" />
          </button>
          <input
            type="search"
            name="q"
            class="header__search-input"
            placeholder="검색"
            aria-label="검색"
            autocomplete="off"
          />
          <kbd class="header__search-kbd">⌘K</kbd>
        </form>
      )}
      {enableDarkMode && (
        <button type="button" class="header__theme-mode-switcher theme-mode-switcher" data-mode="light" aria-label="Toggle theme">
          <Icon name="dark_mode" class="theme-mode-switcher__icon icon-dark" />
          <Icon name="light_mode" class="theme-mode-switcher__icon icon-light" />
        </button>
      )}
      {languageOptions.length > 1 && <LanguageSwitcher lang={lang} options={languageOptions} />}
      <button type="button" class="header__menu-toggle" aria-label="메뉴 열기">
        <Icon name="menu" class="header__menu-icon" />
      </button>
    </div>
  </div>
  {backLink && <div class="header__progress" aria-hidden="true"><span class="header__progress-bar"></span></div>}
</header>

{backLink && (
  <script is:inline>
    // Reading progress bar on post pages
    (() => {
      const bar = document.querySelector('.header__progress-bar');
      if (!bar) return;
      const update = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        bar.style.transform = `scaleX(${ratio})`;
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    })();
  </script>
)}
