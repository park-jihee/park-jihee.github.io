---
import Layout from './Layout.astro';
import FloatingTOC from '@components/FloatingTOC.astro';
import InlineTOC from '@components/InlineTOC.astro';
import { type PageEntry, getPageLanguage } from '@lib/content';

const {
  entry,
  Content,
  headings = [],
  alternates = [],
}: {
  entry: PageEntry;
  Content: any;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  alternates?: Array<{ lang: string; url: string }>;
} = Astro.props;

const lang = getPageLanguage(entry);
---
<Layout
  title={entry.data.title}
  description={entry.data.description}
  alternates={alternates}
>
  <div class="article-wrap article-wrap--with-aside">
    <aside class="article-wrap__aside">
      {headings.length > 0 && <FloatingTOC headings={headings} lang={lang} />}
    </aside>

    <div class="article">
      <article>
        <div class="article__head">
          <h1 class="h1">{entry.data.h1 ?? entry.data.title}</h1>
        </div>

        <InlineTOC headings={headings} />

        <div class="text-block article__text-block">
          <Content />
        </div>
      </article>
    </div>
  </div>
</Layout>
